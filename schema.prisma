generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "cockroachdb"
  url      = env("DB_URL")
}

model User {
  id                 String          @id @unique
  username           String          @unique
  avatarUrl          String?
  friends            User[]          @relation("UserFriends")
  directMsgs         Channel[]       @relation("UserDirectMsgs")
  friendOf           User[]          @relation("UserFriends")
  blocked            String[]
  sentRequests       FriendRequest[] @relation("SentRequests")
  receivedRequests   FriendRequest[] @relation("ReceivedRequests")
  auth               Auth?
  messages           Messages[]
  servers            Server[]        @relation("UserServers")
  VoiceChat          VoiceChat?      @relation(fields: [voiceChatChannelId], references: [channelId])
  voiceChatChannelId String?
}

model FriendRequest {
  id         String              @id @default(uuid())
  senderId   String
  receiverId String
  status     FriendRequestStatus @default(PENDING)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  sender   User @relation("SentRequests", fields: [senderId], references: [id])
  receiver User @relation("ReceivedRequests", fields: [receiverId], references: [id])
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELED
  BLOCKED
}

model Server {
  id         String     @id @unique @default(uuid())
  iconUrl    String
  name       String
  ownerId    String
  invites    String[]
  categories Category[] @relation("ServerCategory")
  members    User[]     @relation("UserServers")
}

enum ChannelType {
  TEXT
  DIRECTMESSAGE
}

model Category {
  id       String    @id @unique @default(uuid())
  index    Int       @default(0)
  name     String
  serverId String
  server   Server    @relation("ServerCategory", fields: [serverId], references: [id])
  channels Channel[] @relation("ChannelCategory")
}

model Channel {
  id           String      @id @unique @default(uuid())
  index        Int         @default(0)
  name         String
  categoryId   String?
  category     Category?   @relation("ChannelCategory", fields: [categoryId], references: [id])
  messages     Messages[]
  directMsgFor User[]      @relation("UserDirectMsgs")
  channelType  ChannelType @default(TEXT)
}

model Auth {
  userId        String @unique
  password_hash String
  salt          String
  id            User   @relation(fields: [userId], references: [id])
}

model Messages {
  id          String     @id @default(uuid())
  content     String
  timestamp   DateTime   @default(now())
  authorId    String
  channelId   String
  repliedToId String?
  repliedTo   Messages?  @relation("MessageReplyTo", fields: [repliedToId], references: [id])
  replies     Messages[] @relation("MessageReplyTo")
  author      User       @relation(fields: [authorId], references: [id])
  channel     Channel    @relation(fields: [channelId], references: [id])

  @@index([timestamp])
}

model UserInfo {
  userId        String @id @unique
  biography     String
  usernameColor String @default("#000D1E")
}

model VoiceChat {
  channelId String   @id @unique
  serverId  String?
  members   User[]
  createdAt DateTime @default(now())
}

enum MutedInType {
  SERVER
  CHANNEl
}

enum MuteType {
  FINITE
  INFINITE
}

model UserMute {
  userId      String      @id @unique
  startedAt   DateTime    @default(now())
  endsAt      DateTime
  mutedIn     String
  mutedInType MutedInType
  muteType    MuteType
}
