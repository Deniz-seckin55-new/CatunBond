generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "cockroachdb"
  url      = env("DB_URL")
}

model User {
  id         String     @id @unique
  username   String     @unique
  avatarUrl  String?
  friends    Json?
  directMsgs Json?
  auth       Auth?
  messages   Messages[]
  servers    Server[]   @relation("UserServers")
}

model Server {
  id       String    @id @unique
  iconUrl  String
  name     String
  ownerId  String
  invites  String[]
  channels Channel[]
  members  User[]    @relation("UserServers")
}

model Channel {
  id       String     @id @unique
  name     String
  serverId String?
  server   Server?    @relation(fields: [serverId], references: [id])
  messages Messages[]
}

model Auth {
  userId        String @unique
  password_hash String
  salt          String
  id            User   @relation(fields: [userId], references: [id])
}

model Messages {
  id          BigInt   @id @default(autoincrement())
  content     String
  timestamp   DateTime @default(now())
  authorId    String
  channelId   String
  repliedToId String?
  author      User     @relation(fields: [authorId], references: [id])
  channel     Channel  @relation(fields: [channelId], references: [id])
}
