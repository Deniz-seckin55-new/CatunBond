generator client {
  provider = "prisma-client-js"
}

generator zod {
  provider = "prisma-zod-generator"
  output   = "./generated/zod"
}

datasource db {
  provider = "cockroachdb"
  url      = env("DB_URL")
}

model User {
  id                 String           @id @unique
  username           String           @unique
  avatarUrl          String?
  blocked            String[]
  voiceChatChannelId String?
  auth               Auth?
  receivedRequests   FriendRequest[]  @relation("ReceivedRequests")
  sentRequests       FriendRequest[]  @relation("SentRequests")
  messages           Messages[]
  VoiceChat          VoiceChat?       @relation(fields: [voiceChatChannelId], references: [channelId])
  directMsgs         Channel[]        @relation("UserDirectMsgs")
  friends            User[]           @relation("UserFriends")
  friendOf           User[]           @relation("UserFriends")
  servers            Server[]         @relation("UserServers")
  variables          Json             @default("{\"channelFontSize\": 16, \"appFontSize\": 36, \"defaultZoomFactor\": 2, \"magnifyingGlassOnPreviews\": true}")
}

model Reaction {
  id        String @id // UserId + MessageId + EmojiName
  userId    String
  emojiName String
  messageId String
  channelId String
  message Messages @relation("MessageReactions", fields: [messageId], references: [id])
}

model FriendRequest {
  id         String              @id @default(uuid())
  senderId   String
  receiverId String
  status     FriendRequestStatus @default(PENDING)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  receiver   User                @relation("ReceivedRequests", fields: [receiverId], references: [id])
  sender     User                @relation("SentRequests", fields: [senderId], references: [id])
}

model Server {
  id         String     @id @unique @default(uuid())
  iconUrl    String
  name       String
  ownerId    String
  invites    String[]
  categories Category[] @relation("ServerCategory")
  members    User[]     @relation("UserServers")
}

model ServerInfo {
  serverId    String   @id @unique
  name        String
  iconUrl     String
  maxUsers    Int
  color       String
  description String
  slogan      String?
  rules       String[]
}

model Category {
  id       String    @id @unique @default(uuid())
  name     String
  serverId String
  index    Int       @default(0)
  server   Server    @relation("ServerCategory", fields: [serverId], references: [id], onDelete: Cascade)
  channels Channel[] @relation("ChannelCategory")
}

model Channel {
  id           String      @id @unique @default(uuid())
  name         String
  channelType  ChannelType @default(TEXT)
  categoryId   String?
  index        Int         @default(0)
  category     Category?   @relation("ChannelCategory", fields: [categoryId], references: [id])
  messages     Messages[]
  directMsgFor User[]      @relation("UserDirectMsgs")
}

model ChannelInfo {
  channelId      String      @id @unique
  name           String
  type           ChannelType
  description    String
  slowMode       Int         @default(0)
  readOnly       Boolean     @default(false)
  nsfw           Boolean     @default(false)
  pinnedMessages String[]
}

model Auth {
  userId        String @unique
  password_hash String
  salt          String
  id            User   @relation(fields: [userId], references: [id])
}

model Messages {
  id          String     @id @default(uuid())
  content     String
  timestamp   DateTime   @default(now())
  authorId    String
  channelId   String
  repliedToId String?
  author      User       @relation(fields: [authorId], references: [id])
  channel     Channel    @relation(fields: [channelId], references: [id])
  repliedTo   Messages?  @relation("MessageReplyTo", fields: [repliedToId], references: [id])
  replies     Messages[] @relation("MessageReplyTo")
  reactions   Reaction[] @relation("MessageReactions")
  attachments Json?
  mentions    String[]

  @@index([timestamp])
}

model UserNote {
  userId      String
  otherUserId String
  note        String

  @@unique([userId, otherUserId])
}

model UserInfo {
  userId           String                   @id @unique
  biography        String
  usernameColor    String                   @default("#000D1E")
  mainLink         String
  shortDescription String
  serverListOrder  ServerListOrderElement[]
}

model ServerListOrderElement {
  id             String    @id
  index          Int
  userInfoUserId String?
  UserInfo       UserInfo? @relation(fields: [userInfoUserId], references: [userId])
}

model VoiceChat {
  channelId String   @id @unique
  serverId  String?
  createdAt DateTime @default(now())
  members   User[]
}

model UserMute {
  userId      String      @id @unique
  startedAt   DateTime    @default(now())
  endsAt      DateTime
  mutedIn     String
  mutedInType MutedInType
  muteType    MuteType
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELED
  BLOCKED
}

enum ChannelType {
  TEXT
  DIRECTMESSAGE
}

enum MutedInType {
  SERVER
  CHANNEl
}

enum MuteType {
  FINITE
  INFINITE
}